{
  "uid": "rpc-xray",
  "title": "rpc-xray",
  "description": "See every request your RPC provider failed.",
  "tags": [
    "rpc-xray"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "label": "Data source",
        "query": "prometheus",
        "current": {}
      },
      {
        "type": "query",
        "name": "chain",
        "label": "Chain",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(rpc_xray_requests_total, chain)",
          "refId": "A"
        },
        "definition": "label_values(rpc_xray_requests_total, chain)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "type": "query",
        "name": "provider",
        "label": "Provider",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(rpc_xray_requests_total{chain=~\"$chain\"}, provider)",
          "refId": "A"
        },
        "definition": "label_values(rpc_xray_requests_total{chain=~\"$chain\"}, provider)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "type": "textbox",
        "name": "target_success",
        "label": "Target success rate",
        "query": "0.9999",
        "current": {
          "text": "0.9999",
          "value": "0.9999"
        },
        "options": [
          {
            "selected": true,
            "text": "0.9999",
            "value": "0.9999"
          }
        ]
      },
      {
        "type": "textbox",
        "name": "target_p95",
        "label": "Target p95 (s)",
        "query": "0.3",
        "current": {
          "text": "0.3",
          "value": "0.3"
        },
        "options": [
          {
            "selected": true,
            "text": "0.3",
            "value": "0.3"
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Where you are, and where you should be",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Success rate",
      "description": "Share of your real RPC requests that got a usable answer in the selected time range. Reverts and invalid requests are your own results and are not counted as failures.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "1 - sum(increase(rpc_xray_requests_total{chain=~\"$chain\", provider=~\"$provider\", outcome=~\"http_error|rate_limited|rpc_error|timeout|network\"}[$__range])) / sum(increase(rpc_xray_requests_total{chain=~\"$chain\", provider=~\"$provider\"}[$__range]))",
          "legendFormat": "You",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "vector($target_success)",
          "legendFormat": "Should be",
          "refId": "B",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "fixed",
            "fixedColor": "#e5484d"
          },
          "mappings": [],
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Should be"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#30a46c"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "You"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#e5484d",
                      "value": null
                    },
                    {
                      "color": "#30a46c",
                      "value": 0.9999
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "p95 latency",
      "description": "One request in twenty was slower than this in the selected time range.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (increase(rpc_xray_request_duration_seconds_bucket{chain=~\"$chain\", provider=~\"$provider\"}[$__range])))",
          "legendFormat": "You",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "vector($target_p95)",
          "legendFormat": "Should be",
          "refId": "B",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "#e5484d"
          },
          "mappings": [],
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Should be"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#30a46c"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "You"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#30a46c",
                      "value": null
                    },
                    {
                      "color": "#e5484d",
                      "value": 0.3
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical"
      },
      "id": 3,
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Minutes with an open incident",
      "description": "Minutes in the selected time range when at least one RPC incident was open: a stale head, a lagging head, failing requests or slow answers.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum_over_time(rpc_xray:incident_any:max5m[$__range]) * 5 or vector(0)",
          "legendFormat": "You",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "vector(0)",
          "legendFormat": "Should be",
          "refId": "B",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "color": {
            "mode": "fixed",
            "fixedColor": "#e5484d"
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Should be"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#30a46c"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "You"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#30a46c",
                      "value": null
                    },
                    {
                      "color": "#e5484d",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical"
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Worst head lag right now",
      "description": "How far the slowest endpoint is behind the best source of the same chain. Users of a lagging endpoint see old balances and miss events.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(rpc_xray:head_lag_seconds{chain=~\"$chain\", provider=~\"$provider\"}) or vector(0)",
          "legendFormat": "You",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "vector(0)",
          "legendFormat": "Should be",
          "refId": "B",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "#e5484d"
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Should be"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#30a46c"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "You"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "#30a46c",
                      "value": null
                    },
                    {
                      "color": "#e5484d",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical"
      },
      "id": 5,
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "row",
      "title": "What waiting has cost so far",
      "collapsed": false,
      "panels": [],
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "timeseries",
      "title": "Failed user requests, adding up",
      "description": "Every failed request since the start of the selected time range. The red line only climbs. The green line is how many failures the same traffic would have had at the target success rate.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(rpc_xray_requests_total{chain=~\"$chain\", provider=~\"$provider\", outcome=~\"http_error|rate_limited|rpc_error|timeout|network\"}[$__interval])) or vector(0)",
          "legendFormat": "failed",
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(rpc_xray_requests_total{chain=~\"$chain\", provider=~\"$provider\"}[$__interval])) * (1 - $target_success)",
          "legendFormat": "target",
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "Time",
            "mode": "outer"
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "cumulativeFunctions",
            "cumulative": {
              "field": "failed",
              "reducer": "sum"
            },
            "alias": "Failed user requests",
            "replaceFields": false
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "cumulativeFunctions",
            "cumulative": {
              "field": "target",
              "reducer": "sum"
            },
            "alias": "Where you should be",
            "replaceFields": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "failed": true,
              "target": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 18,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Failed user requests"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#e5484d"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Where you should be"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#30a46c"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1m",
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 14,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Failed user requests",
      "description": "Requests in the selected time range that returned an HTTP error, were rate limited, timed out, never connected, or came back with a provider error at HTTP 200.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(rpc_xray_requests_total{chain=~\"$chain\", provider=~\"$provider\", outcome=~\"http_error|rate_limited|rpc_error|timeout|network\"}[$__range])) or vector(0)",
          "legendFormat": "Failed",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#e5484d"
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical"
      },
      "id": 8,
      "gridPos": {
        "x": 14,
        "y": 8,
        "w": 5,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Time users waited beyond 1 s",
      "description": "Total waiting time above one second per request in the selected time range.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(rpc_xray_slow_seconds_total{chain=~\"$chain\", provider=~\"$provider\"}[$__range])) or vector(0)",
          "legendFormat": "Waited",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "#e5484d"
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical"
      },
      "id": 9,
      "gridPos": {
        "x": 19,
        "y": 8,
        "w": 5,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Estimated loss",
      "description": "Failed requests multiplied by the value of one request. Shown only when valuePerRequest is set in rpc-xray.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum(increase(rpc_xray_requests_total{chain=~\"$chain\", provider=~\"$provider\", outcome=~\"http_error|rate_limited|rpc_error|timeout|network\"}[$__range])) or vector(0)) * on () max(rpc_xray_value_per_request_usd)",
          "legendFormat": "Lost",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "#e5484d"
          },
          "mappings": [],
          "decimals": 0,
          "noValue": "Set valuePerRequest"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical"
      },
      "id": 10,
      "gridPos": {
        "x": 14,
        "y": 11,
        "w": 5,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "Failures this week against last week",
      "description": "Failed requests in the last 7 days and in the 7 days before that.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum_over_time(rpc_xray:failed_requests:rate5m_total[7d]) * 300",
          "legendFormat": "This week",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum_over_time(rpc_xray:failed_requests:rate5m_total[7d] offset 7d) * 300",
          "legendFormat": "Last week",
          "refId": "B",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#e5484d"
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Last week"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#f5a524"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "orientation": "vertical"
      },
      "id": 11,
      "gridPos": {
        "x": 19,
        "y": 11,
        "w": 5,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      }
    },
    {
      "type": "stat",
      "title": "If nothing changes: next 30 and 90 days",
